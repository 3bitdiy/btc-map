{
  "version": 8,
  "name": "BTC Map Minimal",
  "glyphs": "https://protomaps.github.io/basemaps-assets/fonts/{fontstack}/{range}.pbf",
  "sprite": "https://openmaptiles.github.io/osm-bright-gl-style/sprite",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "pmtiles://PMTILES_URL_PLACEHOLDER",
      "attribution": "© <a href='https://openmaptiles.org'>OpenMapTiles</a> © <a href='https://openstreetmap.org'>OpenStreetMap</a>"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": { "background-color": "#edd1aa" }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": { "fill-color": "#c2c9bc", "fill-antialias": true }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#c2c9bc",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.2, 12, 1],
        "line-opacity": 0.35
      }
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["in", "class", "grass", "scrub", "wood", "forest"],
      "paint": { "fill-color": "#edd1aa", "fill-opacity": 1 }
    },
    {
      "id": "landuse-park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["in", "class", "park", "pitch", "cemetery", "garden"],
      "paint": { "fill-color": "#edd1aa", "fill-opacity": 1 }
    },
    {
      "id": "roads-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "track"],
      "minzoom": 13,
      "paint": {
        "line-color": "#ccbba2",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.25, 16, 1.2],
        "line-opacity": 0.18
      }
    },
    {
      "id": "roads-secondary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "secondary", "tertiary"],
      "paint": {
        "line-color": "#baa890",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.15, 14, 1.2],
        "line-opacity": 0.2
      }
    },
    {
      "id": "roads-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "primary"],
      "paint": {
        "line-color": "#a79177",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.2, 14, 1.5],
        "line-opacity": 0.24
      }
    },
    {
      "id": "roads-motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "motorway", "trunk"],
      "paint": {
        "line-color": "#907a62",
        "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.2, 14, 1.8],
        "line-opacity": 0.24
      }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["==", "admin_level", 2],
      "paint": {
        "line-color": "#7b8fa3",
        "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.9, 10, 2.2],
        "line-opacity": 0.9
      }
    },
    {
      "id": "place-state",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", "class", "state"],
      "minzoom": 6,
      "maxzoom": 7,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 5, 10, 8, 13],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.1
      },
      "paint": {
        "text-color": "#8d313a",
        "text-halo-width": 0,
        "text-opacity": 0.7
      }
    },
    {
      "id": "place-country",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", "class", "country"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 11, 8, 16],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.15
      },
      "paint": {
        "text-color": "#8d313a",
        "text-halo-width": 0,
        "text-opacity": 0.9
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", "class", "city", "town"],
      "minzoom": 7,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 7, 11, 10, 13, 12, 15],
        "text-anchor": "bottom",
        "text-offset": [0, -0.3]
      },
      "paint": {
        "text-color": "#8d313a",
        "text-halo-width": 0,
        "text-opacity": 0.76
      }
    }
  ]
}
